# Test non-interactive remote adoption when an ancestor PR is already merged.
#
# Remote stack:  main -> feat-a (PR1, merged) -> feat-b (PR2)
#
# feat-a is merged, so only feat-b is adopted and it is reparented onto main.
# The dry-run plan must show the same parent as the real adoption.

exec git checkout -b feat-a
commit-file a.txt 'a\n' 'Commit a'
exec git checkout -b feat-b
commit-file b.txt 'b\n' 'Commit b'
exec git push origin feat-a feat-b

# Squash-merge feat-a into main.
exec git checkout main
exec git merge --squash feat-a
exec git commit --no-edit
exec git push origin main
exec git branch -D feat-a feat-b

mock-pull feat-a 1 MERGED main base=main body=$WORK/feat-a-body.txt
mock-pull feat-b 2 OPEN base=feat-a body=$WORK/feat-b-body.txt

exec av adopt --remote feat-b --yes --dry-run
stdout 'feat-b \(parent: main\)'
! stdout 'feat-a \(parent'

exec av adopt --remote feat-b --yes
branch-parent feat-b main
! exec git rev-parse --verify refs/heads/feat-a

-- feat-a-body.txt --
<!-- av pr metadata
```
{"parent":"main","trunk":"main"}
```
-->
-- feat-b-body.txt --
<!-- av pr metadata
```
{"parent":"feat-a","parentPull":1,"trunk":"main"}
```
-->
